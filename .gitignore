.idea/
.vscode/
*.sublime-*

# Logs et temporaires
*.log
*.bak
*.swp
*~

# Exports du manuel de l'éditeur. Ils se régénèrent en une commande depuis
# `documentation/manuel-administration.html`, qui est la source de vérité —
# voir README §7 bis. Les versionner pousserait un binaire de 600 Ko sur le
# serveur à chaque envoi FTP, pour un fichier que personne n'y lit.
documentation/Manuel-administration-site-Yace.pdf
documentation/Manuel-administration-site-Yace.docx
documentation/pylib/

# Surcharge de configuration locale (identifiants de production)
config/config.local.php

# Fichiers téléversés depuis le back-office. Le dossier reste versionné pour
# deux fichiers seulement : le témoin de présence, et la règle qui interdit
# l'exécution de ce qui y sera déposé — sans elle en production, le premier
# .php téléversé s'exécuterait.
medias/*
!medias/.gitkeep
!medias/.htaccess
